{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": ".homeybuild/",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "homey": ["./node_modules/@types/homey"]
    }
  },
  "include": [
    "lib/**/*.ts",
    "app.ts",
    "drivers/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "test"
  ]
}
